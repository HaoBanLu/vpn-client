{
  "name": "vpn-tauri",
  "version": "1.2.25",
  "private": true,
  "type": "module",
  "description": "跨云 Tauri 跨端客户端",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:win:dev": "powershell -ExecutionPolicy Bypass -File scripts/desktop-dev-windows.ps1",
    "tauri:win:build": "powershell -ExecutionPolicy Bypass -File scripts/desktop-build-windows.ps1",
    "tauri:mac:dev": "bash scripts/desktop-dev-unix.sh",
    "tauri:mac:build": "bash scripts/desktop-build-unix.sh dmg",
    "tauri:linux:dev": "bash scripts/desktop-dev-unix.sh",
    "tauri:linux:build": "bash scripts/desktop-build-unix.sh deb",
    "tauri:linux:build:appimage": "bash scripts/desktop-build-unix.sh appimage",
    "tauri:ios:generate": "cd platforms/ios && xcodegen generate",
    "tauri:ios:build": "bash scripts/ios-build.sh",
    "tauri:ios:build:ipa": "bash scripts/ios-build-ipa.sh",
    "tauri:ios:check": "bash scripts/ios-build.sh",
    "tauri:ios:fetch-mihomo": "bash scripts/fetch-mihomo-ios.sh",
    "tauri:ios:setup-native": "bash scripts/setup-mihomo-ios-native.sh",
    "tauri:ios:build-xcframework": "bash scripts/build-mihomo-ios-xcframework.sh",
    "tauri:android": "powershell -ExecutionPolicy Bypass -File scripts/android-dev-windows.ps1",
    "tauri:android:dev": "powershell -ExecutionPolicy Bypass -File scripts/android-dev-windows.ps1",
    "sync:android-vpn": "powershell -ExecutionPolicy Bypass -File scripts/sync-android-vpn.ps1",
    "tauri:android:build": "powershell -ExecutionPolicy Bypass -File scripts/android-build-windows.ps1",
    "tauri:android:build:release": "powershell -ExecutionPolicy Bypass -File scripts/android-build-windows.ps1 -Release",
    "tauri:android:build:install": "powershell -ExecutionPolicy Bypass -File scripts/android-build-windows.ps1 -Install",
    "tauri:android:build:release:install": "powershell -ExecutionPolicy Bypass -File scripts/android-build-windows.ps1 -Release -Install",
    "tauri:android:install": "powershell -ExecutionPolicy Bypass -File scripts/android-install-windows.ps1 -Debug",
    "tauri:android:install:release": "powershell -ExecutionPolicy Bypass -File scripts/android-install-windows.ps1 -Release",
    "tauri:android:install:release:clean": "powershell -ExecutionPolicy Bypass -File scripts/android-install-windows.ps1 -Release -Clean",
    "fetch:mihomo": "node scripts/run-fetch-mihomo.js",
    "generate:icon": "powershell -ExecutionPolicy Bypass -File scripts/generate-app-icon.ps1",
    "fetch:bundle-tools": "powershell -ExecutionPolicy Bypass -File scripts/fetch-bundle-tools.ps1",
    "tauri:build:exe": "powershell -ExecutionPolicy Bypass -File scripts/desktop-build-exe-windows.ps1",
    "setup": "npm install && npm run fetch:mihomo",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-windows.ps1",
    "preflight:desktop": "node scripts/desktop-preflight.mjs",
    "lint": "eslint . --ext .vue,.ts --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:updater": "powershell -ExecutionPolicy Bypass -File scripts/setup-updater-keys.ps1",
    "tauri:dev": "powershell -ExecutionPolicy Bypass -File scripts/desktop-dev-windows.ps1",
    "tauri:build": "powershell -ExecutionPolicy Bypass -File scripts/desktop-build-windows.ps1",
    "tauri:desktop:dev": "powershell -ExecutionPolicy Bypass -File scripts/desktop-dev-windows.ps1",
    "tauri:desktop:build": "powershell -ExecutionPolicy Bypass -File scripts/desktop-build-windows.ps1"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.2.0",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "pinia": "^2.3.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
