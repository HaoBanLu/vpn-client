# 与 apps/android/app/build.gradle.kts releaseAppBaseUrl 对齐（生产构建用）
VITE_API_BASE_URL=http://192.229.87.112:44080/api

# 正式包还会读 .env.production（若存在会覆盖上面的值）。请保持与 Android 一致：
# VITE_API_BASE_URL=http://192.229.87.112:44080/api

# 开发模式见 .env.development（默认 /api + Vite 代理，避免浏览器 CORS）

# 本地 Docker 调试时可改为：
# VITE_API_BASE_URL=http://127.0.0.1:48080/api

# 可选：Tauri 内置 updater 公钥（运行 npm run setup:updater 生成）
# TAURI_UPDATER_PUBKEY=
