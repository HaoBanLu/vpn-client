# 复制为 keystore.properties（已在 .gitignore，不会提交）
#   copy keystore.properties.example keystore.properties
# 然后填入密码。keystore 文件应在：keystore/kuayun-release.keystore
#
# 迁仓说明：keystore.properties 不会随 git 复制；缺此文件时 Android Studio Sync/Debug
# 仍可运行（暂用 debug 签名）。正式打 Release 包前必须配置本文件，或临时加 -PuseDebugSigning
#
# 也可将下列项写入 local.properties（二选一即可）。
# 生成 keystore：bash scripts/create-release-keystore.sh

storeFile=keystore/kuayun-release.keystore
storePassword=请填写
keyAlias=key0
keyPassword=请填写
